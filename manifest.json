{
  "manifest_version": 3,
  "name": "Simple Site Blocker",
  "version": "0.1.0",
  "description": "Block a site with one click. Unblock it from the site itself or from your list.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "declarativeNetRequest", "tabs"],
  "host_permissions": ["<all_urls>"]
}
